{
  "rewrites": [
    {
      "source": "/shindan/api/:path*",
      "destination": "https://ai-shindan-app-one.vercel.app/api/:path*"
    },
    {
      "source": "/shindan",
      "destination": "https://ai-shindan-app-one.vercel.app/"
    },
    {
      "source": "/shindan/:path*",
      "destination": "https://ai-shindan-app-one.vercel.app/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog/:id",
      "destination": "/api/article?type=blog&id=:id"
    },
    {
      "source": "/news/:id",
      "destination": "/api/article?type=news&id=:id"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:page(home|news|blog|voices|cases|about|partner|contact|recruit|privacy|shiryo|admin)",
      "destination": "/index.html"
    },
    {
      "source": "/:page(home|news|blog|voices|cases|about|partner|contact|recruit|privacy|shiryo|admin)/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/article.js": {
      "includeFiles": "data/**"
    },
    "api/sitemap.js": {
      "includeFiles": "data/**"
    }
  }
}
